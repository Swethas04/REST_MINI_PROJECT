{
  "info": {
    "_postman_id": "c1f8a845-6677-4a0e-8fb8-81d3923efc88",
    "name": "Library Book Management System API",
    "description": "Comprehensive Postman collection for testing the Spring Boot REST API for the Library Book Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Book (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 599.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Creates a new book in the library system. Expects HTTP 201 Created."
      },
      "response": []
    },
    {
      "name": "2. Get All Books (200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Retrieves the full list of books currently stored in the library database. Expects HTTP 200 OK."
      },
      "response": []
    },
    {
      "name": "3. Get Book By ID (200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Retrieves a single book by its unique primary key ID. Expects HTTP 200 OK."
      },
      "response": []
    },
    {
      "name": "4. Update Book (200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code: A Handbook of Agile Software Craftsmanship\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 649.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Updates an existing book record. Expects HTTP 200 OK."
      },
      "response": []
    },
    {
      "name": "5. Delete Book (204 No Content)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Deletes a book by ID. Expects HTTP 204 No Content."
      },
      "response": []
    },
    {
      "name": "6. Invalid Book ID - Not Found (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "99999"
          ]
        },
        "description": "Attempts to retrieve a non-existent book ID. Expects HTTP 404 Not Found."
      },
      "response": []
    },
    {
      "name": "7. Invalid Request Body - Validation Error (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"author\": \"\",\n  \"price\": -50.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Attempts to send blank title, blank author, and negative price. Expects HTTP 400 Bad Request with field errors map."
      },
      "response": []
    }
  ]
}
